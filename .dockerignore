# Do NOT ignore everything with '*'. Instead ignore standard dev build noise:
.git/
.github/
.idea/
.vscode/
*.iml
*.log
*.tmp

# Exclude target folders except under assemblies (where built artifacts live)
**/target/*
!assemblies/client/target/**
!assemblies/web/target/**
!assemblies/plugins/target/**

# Ensure docker context sources are allowed
!docker/
!docker/**